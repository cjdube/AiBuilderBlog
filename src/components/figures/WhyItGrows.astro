---
import Figure from '../Figure.astro';
---

<Figure lead="Why it grows." caption="The model on the right starts blank on every call, so the message list on the left has to carry the whole history forward. A tool result appended on turn 2 is still being re-sent on turn 25.">
    <svg viewBox="0 0 900 300" role="img" aria-label="Three turns of the loop. Each turn re-sends the entire transcript to a model that starts blank, and each tool result is appended permanently.">
          <defs>
            <marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="currentColor"></path>
            </marker>
          </defs>

          <text class="svg-head" x="30" y="26">What the loop sends, growing every turn</text>
          <text class="svg-head" x="676" y="26">The model — blank every turn</text>

          <text class="svg-tag" x="30" y="70" fill="var(--slate)">TURN 1</text>
          <rect x="100" y="54" width="150" height="24" fill="var(--seg-base)" rx="2"></rect>
          <text class="svg-label svg-on-seg" x="108" y="71">rules + task</text>
          <text class="svg-small" x="262" y="71">4,308</text>
          <line x1="330" y1="66" x2="660" y2="66" stroke="currentColor" stroke-width="1.5" marker-end="url(#ar)"></line>
          <text class="svg-small" x="400" y="58">the whole transcript</text>
          <rect x="676" y="46" width="190" height="40" fill="none" stroke="currentColor" stroke-width="1.5" rx="2"></rect>
          <text class="svg-label" x="694" y="71">reads it, replies, forgets</text>

          <text class="svg-tag" x="30" y="146" fill="var(--slate)">TURN 2</text>
          <rect x="100" y="130" width="150" height="24" fill="var(--seg-base)" rx="2"></rect>
          <rect x="252" y="130" width="50" height="24" fill="var(--seg-source)" rx="2"></rect>
          <text class="svg-label svg-on-seg" x="108" y="147">rules + task</text>
          <text class="svg-small" x="314" y="147">5,743</text>
          <text class="svg-small" x="252" y="170" fill="var(--lbl-source)">+1,435 the source file</text>
          <line x1="382" y1="142" x2="660" y2="142" stroke="currentColor" stroke-width="1.5" marker-end="url(#ar)"></line>
          <text class="svg-small" x="420" y="134">all of it, again</text>
          <rect x="676" y="122" width="190" height="40" fill="none" stroke="currentColor" stroke-width="1.5" rx="2"></rect>
          <text class="svg-label" x="694" y="147">reads it, replies, forgets</text>

          <text class="svg-tag" x="30" y="222" fill="var(--slate)">TURN 3</text>
          <rect x="100" y="206" width="150" height="24" fill="var(--seg-base)" rx="2"></rect>
          <rect x="252" y="206" width="50" height="24" fill="var(--seg-source)" rx="2"></rect>
          <rect x="304" y="206" width="195" height="24" fill="var(--seg-list)" rx="2"></rect>
          <text class="svg-label svg-on-seg" x="108" y="223">rules + task</text>
          <text class="svg-label svg-on-seg" x="312" y="223">416 page names</text>
          <text class="svg-small" x="511" y="223">11,333</text>
          <text class="svg-small" x="304" y="246" fill="var(--lbl-list)">+5,590 — the biggest single jump of the run</text>
          <line x1="576" y1="218" x2="660" y2="218" stroke="currentColor" stroke-width="1.5" marker-end="url(#ar)"></line>
          <rect x="676" y="198" width="190" height="40" fill="none" stroke="currentColor" stroke-width="1.5" rx="2"></rect>
          <text class="svg-label" x="694" y="223">reads it, replies, forgets</text>

          <text class="svg-small" x="100" y="284" fill="var(--slate)">…and so on for 22 more turns. Nothing is ever removed.</text>
        </svg>
</Figure>
