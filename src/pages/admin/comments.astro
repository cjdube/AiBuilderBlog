---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Comments — Moderation" description="Pending comments awaiting moderation." noindex>
  <main class="mod">
    <p class="eyebrow">Admin</p>
    <h1>Comments — Moderation</h1>
    <p id="status" class="status" role="status">Loading…</p>
    <ul id="list" class="list"></ul>
  </main>
</BaseLayout>

<script>
  const statusEl = document.getElementById('status') as HTMLElement;
  const listEl = document.getElementById('list') as HTMLElement;

  function setStatus(text: string, isError = false) {
    statusEl.textContent = text;
    statusEl.classList.toggle('error', isError);
    statusEl.hidden = text === '';
  }

  function checkEmpty() {
    if (listEl.children.length === 0) setStatus('Nothing waiting.');
  }

  async function act(id: string | number, action: string, item: HTMLElement) {
    const buttons = item.querySelectorAll('button');
    buttons.forEach((b) => (b.disabled = true));
    try {
      const res = await fetch('/api/admin/comments/' + encodeURIComponent(String(id)), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || 'HTTP ' + res.status);
      item.remove();
      checkEmpty();
    } catch (err) {
      buttons.forEach((b) => (b.disabled = false));
      setStatus('Could not ' + action + ' comment: ' + (err as Error).message, true);
    }
  }

  function buildItem(c: any) {
    const li = document.createElement('li');
    li.className = 'item';

    const meta = document.createElement('p');
    meta.className = 'meta';

    const slug = String(c.post_slug ?? '');
    if (/^[a-z0-9-]+$/.test(slug)) {
      const a = document.createElement('a');
      a.href = '/blog/' + slug + '/';
      a.textContent = slug;
      meta.append(a);
    } else {
      const s = document.createElement('span');
      s.textContent = slug;
      meta.append(s);
    }
    const who = document.createElement('span');
    who.textContent = ' · ' + String(c.name ?? '') + ' · ' + String(c.created_at ?? '');
    meta.append(who);

    const body = document.createElement('p');
    body.className = 'body';
    body.textContent = String(c.body ?? '');

    const actions = document.createElement('div');
    actions.className = 'actions';
    for (const [action, label] of [['approve', 'Approve'], ['spam', 'Spam'], ['delete', 'Delete']]) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = action;
      b.textContent = label;
      b.addEventListener('click', () => {
        if (action === 'delete' && !window.confirm('Delete this comment permanently?')) return;
        act(c.id, action, li);
      });
      actions.append(b);
    }

    li.append(meta, body, actions);
    return li;
  }

  async function load() {
    try {
      const res = await fetch('/api/admin/comments');
      if (res.status === 403) {
        setStatus('Not signed in. Cloudflare Access protects this page.', true);
        return;
      }
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const rows = await res.json();
      if (!Array.isArray(rows)) throw new Error('Unexpected response');
      setStatus('');
      for (const c of rows) listEl.append(buildItem(c));
      checkEmpty();
    } catch (err) {
      setStatus('Could not load comments: ' + (err as Error).message, true);
    }
  }

  load();
</script>

<style>
  .mod { max-width: 66ch; width: 100%; margin: 0 auto; padding: 3rem 1rem 4rem; }
  .eyebrow {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--slate); margin: 0 0 0.5rem;
  }
  h1 { color: var(--ink); margin: 0 0 1.5rem; }
  .status { color: var(--slate); }
  .status.error { color: var(--rust); }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .item { background: var(--panel); border: 1px solid var(--hairline); padding: 1rem; }
  .meta { color: var(--slate); font-size: 0.85rem; margin: 0 0 0.6rem; }
  .meta a { color: var(--ochre); }
  .body { color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; margin: 0 0 0.9rem; }
  .actions { display: flex; gap: 0.5rem; }
  button {
    font: inherit; font-size: 0.85rem; cursor: pointer; padding: 0.3rem 0.8rem;
    background: transparent; color: var(--ink); border: 1px solid var(--hairline);
  }
  button:disabled { opacity: 0.5; cursor: default; }
  button.approve { color: var(--sage); border-color: var(--sage); }
  button.spam { color: var(--ochre); border-color: var(--ochre); }
  button.delete { color: var(--rust); border-color: var(--rust); }
</style>
