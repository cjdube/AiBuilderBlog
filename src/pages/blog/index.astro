---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import emblem from '../../assets/odyssey-emblem.webp';

const posts = (
  await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
  });
---

<BaseLayout
  title="A Builder's Odyssey — Craig Dubé"
  description="Notes from building local AI agents on one Mac mini: what works, what it costs, and what it measured."
>
  <div class="wrap">
    <header class="masthead wide">
      <div class="masthead-row">
        <div class="masthead-text">
          <p class="eyebrow">Craig Dubé</p>
          <h1>A Builder&rsquo;s Odyssey</h1>
          <p class="standfirst">
            Notes from building local AI agents on one Mac mini. What I built, the
            trade-offs I made, and what the numbers actually said.
          </p>
        </div>
        <Image class="emblem" src={emblem} alt="An ancient Greek galley under sail at sunset, in a round emblem" widths={[200, 400]} sizes="200px" loading="eager" />
      </div>
      <hr class="rule" />
    </header>

    <section class="col wide">
      <ul class="postlist thumbs">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-text">
                <span class="date">{fmt(post.data.pubDate)}</span>
                <h2>{[post.data.title, post.data.subtitle].filter(Boolean).join(' ')}</h2>
                <span class="dek">{post.data.standfirst}</span>
              </span>
              <Image
                class:list={['thumb', !post.data.cover && 'is-emblem']}
                src={post.data.cover ?? emblem}
                alt=""
                widths={[200, 400]}
                sizes="160px"
              />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
