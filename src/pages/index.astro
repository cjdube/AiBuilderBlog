---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Offers from '../components/Offers.astro';
import SiteFoot from '../components/SiteFoot.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const builds = [
  { name: 'PodiumBoard', job: 'Sign-ups and materials for volunteer speakers bureaus', status: 'Live', tone: 'live', href: 'https://demo.podiumboard.com/try' },
  { name: 'Townsight', job: 'Town meetings in plain words, before the vote', status: 'Pilot', tone: 'pilot', href: 'https://townsight.craigdube.dev/newfields-nh/' },
  { name: 'Wren', job: 'My personal AI agent, running on one Mac mini', status: 'Open source', tone: 'oss', href: 'https://github.com/cjdube/LocalLLMAgent' },
  { name: 'ScribeJay', job: 'A local journal that writes down your day', status: 'Open source', tone: 'oss', href: 'https://github.com/cjdube/ScribeJay' },
  { name: 'Obsidian Wiki Agent', job: 'Turns raw notes into a wiki, on your own machine', status: 'Open source', tone: 'oss', href: 'https://github.com/cjdube/ObsidianWikiAgent' },
  { name: 'Claude skills', job: 'Planning, review and writing skills for Claude Code', status: 'Open source', tone: 'oss', href: 'https://github.com/cjdube/claude-skills' },
  // shortcut: served by the current craigdube.dev host, not this repo; keep the path when this site takes over the root.
  { name: 'Interval timer', job: 'A workout timer built for the iPhone', status: 'Live', tone: 'live', href: '/workouttimer' },
];
---

<BaseLayout
  title="Craig Dubé — Fractional product leader"
  description="35 years in software. I work with a few small software companies at a time, one or two days a week, as the product leader you aren't ready to hire full time."
>
  <div class="wrap">
    <header class="hero">
      <div class="hero-text">
        <p class="eyebrow">Fractional product leader &middot; Newfields, NH</p>
        <h1>The product leader you aren&rsquo;t ready to hire full time.</h1>
        <p class="standfirst">
          35 years in software, most recently Senior Director of Product
          Management at impact.com and Head of Product at Meltwater. Now I work
          with a few small software companies at a time, one or two days a
          week, through VibeFoundry Tech Advisory LLC.
        </p>
        <p>
          I still build. Everything in the list is mine, made with the same AI
          tools I&rsquo;d help your team use.
        </p>
        <div class="cta-row">
          <a class="btn" href="/work-with-me/#talk">Let&rsquo;s talk for 20 minutes</a>
          <a class="btn ghost" href="/one-sheet/">Get the one-sheet</a>
        </div>
      </div>

      <section class="ledger" aria-labelledby="built">
        <h2 class="ledger-head" id="built"><span>Things I&rsquo;ve built</span><span>{builds.length}</span></h2>
        <ul>
          {builds.map((b) => (
            <li>
              <a href={b.href}>
                <span><b>{b.name}</b><span class="job">{b.job}</span></span>
                <span class={`status ${b.tone}`}>{b.status}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </header>

    <section class="band" aria-labelledby="proof">
      <h2 class="band-head" id="proof">Where I&rsquo;ve done it</h2>
      <div class="proof">
        <div><b>impact.com</b><span>Led the teams that built tracking, contracting, campaign management and reporting</span></div>
        <div><b>SaaSquatch deal</b><span>Product due diligence and the 18-month integration plan, 2023</span></div>
        <div><b>Meltwater</b><span>Built and coached a global team of six product managers</span></div>
        <div><b>AARP NH</b><span>Daily coordinator update cut from 2 hours to 15 minutes</span></div>
      </div>
    </section>

    <section class="band" aria-labelledby="ways">
      <h2 class="band-head" id="ways">Ways to work together</h2>
      <Offers />
      <p><a href="/work-with-me/">How I work and what week one looks like &rarr;</a></p>
    </section>

    <section class="band" aria-labelledby="latest">
      <h2 class="band-head" id="latest">Latest from A Builder&rsquo;s Odyssey</h2>
      <ul class="postlist compact">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="date">{fmt(post.data.pubDate)}</span>
              <h3 class="post-title">{[post.data.title, post.data.subtitle].filter(Boolean).join(' ')}</h3>
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/blog/">All writing &rarr;</a></p>
    </section>

    <SiteFoot />
  </div>
</BaseLayout>
