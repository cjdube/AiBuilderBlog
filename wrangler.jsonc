{
  // Static-site Worker: no server script, just the built files in dist/.
  // Cloudflare runs `npm run build` and then `npx wrangler deploy`, which
  // reads this file to know what to upload.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craigdube-dev",
  "compatibility_date": "2026-08-21",
  // The blog is served from blog.craigdube.dev via a Workers Route. Turning
  // these off keeps that the only public address, so search engines don't see
  // the same posts at two URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
